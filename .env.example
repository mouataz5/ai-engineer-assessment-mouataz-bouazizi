# Copy to .env and fill in. Never commit .env.

# Groq (https://console.groq.com) - the hosted LLM
# GROQ_MODEL: check `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $KEY"`
# for what your account can access - model availability varies.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Superhero API (https://superheroapi.com - sign in with GitHub for a token)
SUPERHERO_API_TOKEN=your_superhero_token_here
SUPERHERO_BASE_URL=https://superheroapi.com/api

# Tuning (optional - defaults shown)
HTTP_TIMEOUT=5.0
LLM_TIMEOUT=20.0
TOP_K=3
DB_PATH=data/movies.db
DATASET_CSV=data/movies.csv
